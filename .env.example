APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Domain Safety Checker
VIRUSTOTAL_ENABLED=true
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_ENABLED=true
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_SAFE_BROWSING_CLIENT_ID=laravel-domain-checker
GOOGLE_SAFE_BROWSING_CLIENT_VERSION=1.0.0
DOMAIN_SAFETY_CACHE_ENABLED=true
DOMAIN_SAFETY_CACHE_TTL=3600
VT_MALICIOUS_MIN=2
VT_SUSPICIOUS_MIN=1

# VT_MIN_HARMLESS_FOR_CLEAN
# Minimum number of VirusTotal engines that must actively mark a domain as
# "harmless" before we call the verdict `clean`. If fewer engines confirm safety
# AND no engines flag it malicious/suspicious, the verdict becomes `unknown`
# instead of `clean` — silence is not approval. Raise this to be stricter
# (e.g. 5 = at least 5 engines must confirm safe).
VT_MIN_HARMLESS_FOR_CLEAN=1

# VT_NEW_DOMAIN_DAYS
# Domains younger than this many days are subject to extra heuristics:
#   - if zero engines confirm safe → suspicious
#   - if VT tags include something in VT_SUSPICIOUS_TAGS → suspicious
#   - if the TLD is in HIGH_RISK_TLDS → suspicious
# Old domains bypass these rules even on quirky TLDs. Set to 0 to disable
# all young-domain heuristics. Lower (e.g. 30) = fewer false positives,
# higher (e.g. 180) = catch more fresh phishing.
VT_NEW_DOMAIN_DAYS=90

VT_SUSPICIOUS_TAGS=self-signed,dynamic-dns,free-dns

# HIGH_RISK_TLDS
# Comma-separated TLDs (no leading dot) with disproportionately high phishing
# and malware abuse rates per Spamhaus / Interisle reports. A young domain on
# one of these TLDs with no engine detections gets flagged `suspicious`.
# Trim this list to be more permissive, or extend it to be stricter.
HIGH_RISK_TLDS=sbs,click,top,xyz,tk,ml,ga,cf,gq,men,live,work,icu,quest,cyou,monster,lol,mom,rest,buzz,zip,mov,cam,beauty,bond,sale,info

# =============================================================================
# Main app webhook integration
# =============================================================================
# This checker is designed to push verdicts back to a "main app" that owns the
# domain list. The flow run by `php artisan domain-safety:sync` is:
#   1. GET  {MAIN_APP_BASE_URL}{MAIN_APP_DOMAINS_ENDPOINT}        — pull list
#   2. for each domain → run VirusTotal + Google Safe Browsing checks
#   3. POST {MAIN_APP_BASE_URL}{MAIN_APP_WEBHOOK_PATH}            — push verdict
#        Headers: X-Webhook-Secret: {MAIN_APP_WEBHOOK_SECRET}
#        Body:    { "is_safe": bool, "threat_type": "MALWARE"|"SOCIAL_ENGINEERING"|... }

# MAIN_APP_ENABLED
# Master switch for the webhook integration. Set to `false` to disable all
# outbound calls to the main app (the local /api/domain/check endpoints still
# work — only the sync command + webhook push is gated by this).
MAIN_APP_ENABLED=true

# MAIN_APP_BASE_URL
# The main app's hostname (no trailing slash). All webhook URLs are built by
# concatenating this with the path templates below.
MAIN_APP_BASE_URL=https://admin.wearenottouchingus.xyz

# MAIN_APP_DOMAINS_ENDPOINT
# Path on the main app that returns the list of domains to check. Expected to
# return JSON shaped like { "data": [ { "domain_name": "..." }, ... ] }.
MAIN_APP_DOMAINS_ENDPOINT=/api/domains

# MAIN_APP_WEBHOOK_PATH
# Path template for the per-domain push endpoint. The literal `{domain}` token
# is substituted with the URL-encoded domain name at request time.
MAIN_APP_WEBHOOK_PATH=/api/webhooks/domain-safety/{domain}

# MAIN_APP_WEBHOOK_SECRET
# Shared secret sent in the `X-Webhook-Secret` header on every webhook POST.
# Must match the secret the main app validates against. If empty, the sync
# command refuses to run (use --dry-run to bypass for local testing).
MAIN_APP_WEBHOOK_SECRET=

# MAIN_APP_TIMEOUT
# HTTP timeout (in seconds) for both the domain-list GET and each webhook
# POST. Bump this if the main app is slow to respond under load.
MAIN_APP_TIMEOUT=15

# MAIN_APP_NOTIFY_ON_UNKNOWN
# What to do when a domain's verdict is `unknown` (no provider returned a
# usable result — e.g. VT 404'd and GSB had no match):
#   false (default) → skip the webhook entirely. Safer — never overwrites a
#                     known-bad status with a stale "safe".
#   true            → POST `is_safe=true, threat_type=null` anyway. Useful
#                     if the main app's UI needs `safety_checked_at` updated
#                     even when we couldn't conclude anything.
MAIN_APP_NOTIFY_ON_UNKNOWN=false
